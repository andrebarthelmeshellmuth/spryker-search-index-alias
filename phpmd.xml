<?xml version="1.0" encoding="UTF-8" ?>

<ruleset name="search-index-alias"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd">

    <description>
        Size/complexity rules for spryker-community/search-index-alias. Runs alongside
        phpmd-public-methods.xml and phpmd-parameter-list.xml as SEPARATE phpmd invocations — PHPMD merges
        every loaded ruleset's exclude-pattern into one global file-ignore list for a single run, so
        keeping each rule's own exemption in its own ruleset (run separately) is the only way to exempt
        just that one rule without also hiding those files from the rules below.
    </description>

    <rule ref="rulesets/codesize.xml/CyclomaticComplexity"/>
    <rule ref="rulesets/codesize.xml/NPathComplexity"/>
    <rule ref="rulesets/codesize.xml/ExcessiveMethodLength"/>
    <rule ref="rulesets/codesize.xml/ExcessiveClassLength"/>
    <!-- The check-installation console has the same WMC-scales-with-surface-area shape as
         search-ranking-optimizer's own exemption for its check-installation console: one small checkX()
         method per installation step, each individually trivial (the per-method rules in this same file
         still apply to them in full and pass), summing to a high class-wide score purely because the
         package has many things worth checking. -->
    <exclude-pattern>*CheckInstallationConsole.php</exclude-pattern>

    <!-- Freshly generated by tests/_ci-standalone/generate-transfers.php, gitignored, never committed,
         same reason a real Spryker project never lints its own src/Generated/. -->
    <exclude-pattern>*/src/Generated/*</exclude-pattern>

    <rule ref="rulesets/codesize.xml/ExcessiveClassComplexity"/>
</ruleset>
